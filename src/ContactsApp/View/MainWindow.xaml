<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ViewModel"
        xmlns:controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800" MinHeight="550" MinWidth="650" Icon="/Resources/icon.ico">

    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="contactTemplate">
            <StackPanel Orientation="Horizontal" Margin="3">
                <Image Width="40" Height="40" Source="/Resources/photoplaceholder.png" Margin="0,0,8,0"/>

                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"/>
                    <TextBlock 
                        FontSize="10" 
                        Text="{Binding PhoneNumber}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="LightPink"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Left"/>

        <Grid Grid.Column="0" Background="#f8f8f8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Label Name="FindLabel" Content="Find: " HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0"/>
                    <TextBox x:Name="SearchTextBox" VerticalAlignment="Top" Margin="44,4,8,0"/>
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox x:Name="ContactsListBox" ItemTemplate="{StaticResource contactTemplate}" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact,Mode=TwoWay}" Margin="8"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="AddButton" Content="Add" Command="{Binding AddContactCommand}" Margin="8,0,3,0"/>
                    <Button Grid.Column="1" x:Name="EditButton" Content="Edit" Command="{Binding EditContactCommand}" Margin="3,0,3,0"/>
                    <Button Grid.Column="2" x:Name="RemoveButton" Content="Remove" Command="{Binding RemoveContactCommand}" Margin="3,0,8,0"/>

                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Column="2" Margin="8">
            <controls:ContactControl VerticalAlignment="Top"/>
            <Button Content="Apply" HorizontalAlignment="Left" Width="75" Height="25" Margin="0,50,0,0" Command="{Binding ApplyCommand}" Visibility="{Binding ApplyButtonVisibility}"/>
        </Grid>
        
    </Grid>

</Window>
